# SelfLab — environment configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# EXPO_PUBLIC_* vars are readable in the app bundle (client). Do NOT put the
# Gemini key here — it lives only as a Supabase Edge Function secret.

# --- Supabase (client) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Maps (Android dev build) ---
# Create a key in Google Cloud Console → enable "Maps SDK for Android".
# Used at build time by app.config.ts (NOT shipped as EXPO_PUBLIC).
GOOGLE_MAPS_API_KEY=

# --- Weather (optional, client) ---
# Open-Meteo is used by default and needs no key. Leave blank unless you swap providers.
EXPO_PUBLIC_WEATHER_API_KEY=

# ----------------------------------------------------------------------------
# Server-side secrets (set with the Supabase CLI, never in this file / git):
#   supabase secrets set GEMINI_API_KEY=your-gemini-key
# ----------------------------------------------------------------------------
